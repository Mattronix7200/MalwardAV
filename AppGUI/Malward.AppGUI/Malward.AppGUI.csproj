<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Malward.AppGUI.Launcher</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Malward</AssemblyName>
    <RootNamespace>Malward.AppGUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyTitle>Malward(R) User Interface Application</AssemblyTitle>
    <Company>jmSOFT</Company>
    <Authors>Jakub Michalski</Authors>
    <Description>Malward Community Edition — skaner drugiej opinii w chmurze</Description>
    <Product>Malward(R) User Interface Application</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FWManager\FWManager.csproj" />
    <ProjectReference Include="..\..\EngineSDK\Malward.Engine\Malward.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <AssetsVdebObj>$(IntermediateOutputPath)assets.vdeb</AssetsVdebObj>
  </PropertyGroup>

  <Target Name="PackAssetsVdeb" BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="@(None);$(MSBuildProjectFullPath)" Outputs="$(AssetsVdebObj)">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Delete Files="$(AssetsVdebObj)" Condition="Exists('$(AssetsVdebObj)')" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\assets"
                  DestinationFile="$(AssetsVdebObj)" Overwrite="true" />
    <Message Importance="high" Text="Spakowano assets → $(AssetsVdebObj) (wbudowane w EXE)" />
  </Target>

  <Target Name="ForceRepackAssets" BeforeTargets="PackAssetsVdeb">
    <Delete Files="$(AssetsVdebObj)" Condition="Exists('$(AssetsVdebObj)')" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(AssetsVdebObj)" Link="assets.vdeb"
                      LogicalName="Malward.AppGUI.assets.vdeb" />
  </ItemGroup>

</Project>
