<Window x:Class="Malward.AppGUI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Malward"
        Width="1058" Height="598"
        MinWidth="1058" MinHeight="598"
        MaxWidth="1058" MaxHeight="598"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False"
        Background="#0E1116"
        Icon="Resources/icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" ProgressState="None" ProgressValue="0" />
    </Window.TaskbarItemInfo>
    <Grid x:Name="RootGrid">
        <Border x:Name="SplashOverlay" Background="#0E1116" IsHitTestVisible="False"/>
    </Grid>
</Window>
